### Eclipse ###
.metadata
tmp/
*.tmp
*.bak
*.swp
*~.nib
local.properties
.settings/
.loadpath
.recommenders

# External tool builders
#.externalToolBuilders/

# Locally stored "Eclipse launch configurations"
*.launch

# Java annotation processor (APT)
.factorypath

# Code Recommenders
.recommenders/

### Eclipse Patch ###
# Eclipse project files are not part of this tree.
.project
.classpath
plugins/**/.project
plugins/**/.classpath

### Java ###
# Compiled class files
*.class

# Log files
*.log

# Package Files — JAR/ZIP are NOT ignored (project uses local JARs as dependencies)
#*.jar
#*.zip
*.tar.gz
*.rar

# Virtual machine crash logs
hs_err_pid*
replay_pid*

### Gradle ###
.gradle/
build/
!**/src/main/**/build/
!**/src/test/**/build/

### IntelliJ IDEA ###
.idea/
*.iml
*.ipr
*.iws
out/

### VS Code ###
.vscode/
*.code-workspace

### macOS ###
.DS_Store
._*

### Windows ###
Thumbs.db
Desktop.ini

### FreeMind CE specific ###

# Auto-generated at runtime
/auto.properties
/.jqwik-database

# JiBX binding JAR (obsolete — replaced by JAXB)
/lib/bindings.jar

# Build output directories (legacy Ant)
bin/dist/
bin/classes/
bin/testclasses/
bin/reports/

# Distribution artifacts
*.dmg
*.pkg
*.exe
*.msi
*.deb
*.rpm

# Test coverage
jacoco/
coverage/

# Legacy Ant build output
/bin/

# Local agent settings. This fork does not ship these directories.
.claude/
.opencode/

# Serena LSP agent (keep .serena/project.yml versioned)
.serena/project.local.yml
.serena/memories/
.serena/cache/
.serena/logs/
.serena/.gitignore

# BMAD workflow framework and output artifacts (local tooling)
_bmad/
_bmad-output/

# Content marketing materials (local only, not committed)
docs/content-marketing/
